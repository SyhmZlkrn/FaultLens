# Copy to .env and fill in. Never commit .env.
# Values come from notebooks.amd.com/tokenfactory (sign in with your AMD AI Developer Program account)
AMD_BASE_URL=
AMD_API_KEY=
AMD_MODEL=
# Optional: other Token Factory models to try in order when the main one is busy, e.g. DeepSeek-V4.1-Flash,MiMo-V2.6-Flash
AMD_FALLBACK_MODELS=
# Seconds before a call counts as failed and the next model is tried
LLM_TIMEOUT_S=90

# Embedding model for search (runs on AMD GPU when building the index, CPU at query time)
EMBED_MODEL=BAAI/bge-small-en-v1.5
